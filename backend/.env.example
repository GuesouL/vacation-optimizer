# Copy to backend/.env (never committed). Loaded by `uvicorn --env-file .env`.
# Must be the same value as API_TOKEN_SECRET in frontend/.env.local.
# Make one with: openssl rand -base64 32
API_TOKEN_SECRET=

# Production only (see docs/deploy.md). Locally the defaults are fine.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Web addresses allowed to call the API, comma separated, no trailing slash.
# ALLOWED_ORIGINS=https://your-site.vercel.app
