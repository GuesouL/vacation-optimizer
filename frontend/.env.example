# Copy to frontend/.env.local (never committed).

# Encrypts the sign-in cookie. Make one with: npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET=
# Signs the 15-minute API token. Same value as API_TOKEN_SECRET in backend/.env.
API_TOKEN_SECRET=

# Local testing: sign in by typing any email. Ignored by production builds.
AUTH_DEV_LOGIN=true

# Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
