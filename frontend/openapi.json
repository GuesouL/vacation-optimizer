    "/groups/{group_id}/windows": {
      "get": {
        "summary": "Optimize",
        "description": "Rank the vacation windows everyone in the group can share.",
        "operationId": "optimize_groups__group_id__windows_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Group Id"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "End"
            }
          },
          {
            "name": "min_days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 31,
              "minimum": 2,
              "default": 3,
              "title": "Min Days"
            }
          },
          {
            "name": "max_days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 31,
              "minimum": 2,
              "default": 16,
              "title": "Max Days"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "best_value",
                "longest"
              ],
              "type": "string",
              "default": "best_value",
              "title": "Sort"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 25,
              "title": "Limit"
            }
          },
          {
            "name": "distinct",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Distinct"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
