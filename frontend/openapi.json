  "components": {
    "schemas": {
      "AcceptIn": {
        "properties": {
          "person_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "minItems": 1,
            "title": "Person Ids"
          }
        },
        "type": "object",
        "required": [
          "person_ids"
        ],
        "title": "AcceptIn"
      },
      "CalendarIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/CalendarKind"
          }
        },
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "title": "CalendarIn"
      },
      "CalendarKind": {
        "type": "string",
        "enum": [
          "FEDERAL",
          "WORK",
          "SCHOOL",
          "LEAGUE",
          "CUSTOM"
        ],
        "title": "CalendarKind"
      },
      "CalendarOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/CalendarKind"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "title": "CalendarOut"
      },
      "Effect": {
        "type": "string",
        "enum": [
          "DAY_OFF",
          "BUSY"
        ],
        "title": "Effect"
      },
      "EventIn": {
        "properties": {
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "effect": {
            "$ref": "#/components/schemas/Effect"
          }
        },
        "type": "object",
        "required": [
          "start_date",
          "end_date",
          "title",
          "effect"
        ],
